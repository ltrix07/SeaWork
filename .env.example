# Пример конфигурации. Скопировать в .env и заполнить: `cp .env.example .env`
# .env в .gitignore и в репозиторий не попадает — ключи туда и только туда.

# --- База ---
# SEAWORK_DATABASE_URL=postgresql+psycopg://seawork:seawork@localhost:5432/seawork

# --- LLM-обогащение (docs/modules/llm-enricher.md) ---
# Выключено по умолчанию: пока не заполнены ВСЕ четыре поля ниже,
# configured_client() возвращает None и конвейер работает на одних правилах.
# Это не аварийный режим, а штатный — см. §3 спеки модуля.

# Свободное имя, попадает в заголовок отчёта `eval enrichment`.
SEAWORK_LLM_PROVIDER=

# Идентификатор модели в терминах провайдера. Входит в ключ кэша:
# при смене модели старые ответы не переиспользуются.
SEAWORK_LLM_MODEL_ID=

# Корень OpenAI-совместимого API. Клиент дописывает `/chat/completions`,
# поэтому URL указывается ДО этого суффикса, обычно с `/v1` на конце.
SEAWORK_LLM_BASE_URL=

SEAWORK_LLM_API_KEY=

# SEAWORK_LLM_TIMEOUT_SECONDS=30
# SEAWORK_LLM_MAX_RETRIES=2

# --- Требование к провайдеру ---
# Клиент шлёт response_format={"type": "json_schema", "strict": true}.
# Провайдер без constrained decoding по схеме ответит 400 на первой же записи:
# это осознанно, свободный текст вместо схемы нам не нужен.
# Режима "json_object" недостаточно — он не гарантирует структуру.
